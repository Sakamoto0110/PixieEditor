<Project>
  <PropertyGroup>
    <_PixieGlfwWinX64 Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">true</_PixieGlfwWinX64>
  </PropertyGroup>

  <ItemGroup Condition="'$(_PixieGlfwWinX64)' == 'true'">
    <None Include="$(PixieBuildSdkRoot)/notices/glfw/LICENSE.md" Link="licenses/glfw.txt"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="VerifyPixieEditorGlfw" Condition="'$(_PixieGlfwWinX64)' == 'true'"
          DependsOnTargets="ValidatePixieEditorBuildSdk">
    <PropertyGroup>
      <_PixieGlfwProfile>authoring</_PixieGlfwProfile>
      <_PixieGlfwProfile Condition="'$(PixieDevelopmentTools)' == 'true'">local-development</_PixieGlfwProfile>
      <_PixieGlfwDll>$([System.IO.Path]::GetFullPath('$(PixieBuildSdkRoot)/profiles/$(_PixieGlfwProfile)/$(Configuration)/bin/glfw3.dll'))</_PixieGlfwDll>
    </PropertyGroup>
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildThisFileDirectory)../eng/VerifySdkGlfw.ps1&quot; -SdkRoot &quot;$(PixieBuildSdkRoot)&quot; -CatalogSha256 $(PixieBuildSdkCatalogSha256) -Profile $(_PixieGlfwProfile) -Configuration $(Configuration)"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PixieGlfwSha256" />
    </Exec>
  </Target>

  <Target Name="SelectPixieEditorGlfw" BeforeTargets="ResolveLockFileCopyLocalFiles"
          DependsOnTargets="ResolvePackageAssets;VerifyPixieEditorGlfw"
          Condition="'$(_PixieGlfwWinX64)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <!-- Retain the package's RID and destination metadata so the normal .NET loader finds our DLL. -->
    <ItemGroup>
      <_PixieGlfwRuntimeTarget Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Hexa.NET.GLFW' And '%(RuntimeTargetsCopyLocalItems.PathInPackage)' == 'runtimes/win-x64/native/glfw3.dll'" />
      <_PixieGlfwNativeAsset Include="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Hexa.NET.GLFW' And '%(NativeCopyLocalItems.PathInPackage)' == 'runtimes/win-x64/native/glfw3.dll'" />
      <RuntimeTargetsCopyLocalItems Remove="@(_PixieGlfwRuntimeTarget)" />
      <NativeCopyLocalItems Remove="@(_PixieGlfwNativeAsset)" />
      <RuntimeTargetsCopyLocalItems Include="@(_PixieGlfwRuntimeTarget->'$(_PixieGlfwDll)')" />
      <NativeCopyLocalItems Include="@(_PixieGlfwNativeAsset->'$(_PixieGlfwDll)')" />
    </ItemGroup>
    <Error Condition="'@(_PixieGlfwRuntimeTarget->Count())' == '0' And '@(_PixieGlfwNativeAsset->Count())' == '0'"
           Text="The PixieEditor build could not identify the Hexa.NET.GLFW Windows x64 native asset to replace." />
  </Target>

  <Target Name="VerifyPixieEditorGlfwOutput" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(_PixieGlfwDll)' != ''">
    <ItemGroup>
      <_PixieGlfwOutput Include="@(_PixieGlfwRuntimeTarget->'$(OutDir)%(DestinationSubDirectory)glfw3.dll');@(_PixieGlfwNativeAsset->'$(OutDir)%(DestinationSubDirectory)glfw3.dll')" />
    </ItemGroup>
    <Copy SourceFiles="$(_PixieGlfwDll)" DestinationFiles="%(_PixieGlfwOutput.Identity)"
          Condition="'@(_PixieGlfwOutput)' != ''" />
    <VerifyFileHash File="%(_PixieGlfwOutput.Identity)" Hash="$(_PixieGlfwSha256)"
                    Condition="'@(_PixieGlfwOutput)' != ''" />
  </Target>

  <Target Name="SelectPixieEditorGlfwForPublish" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="VerifyPixieEditorGlfw"
          Condition="'$(_PixieGlfwWinX64)' == 'true'">
    <ItemGroup>
      <_PixieGlfwPublishAsset Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'glfw3.dll' And ('%(ResolvedFileToPublish.RelativePath)' == 'glfw3.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes/win-x64/native/glfw3.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\win-x64\native\glfw3.dll')" />
      <ResolvedFileToPublish Remove="@(_PixieGlfwPublishAsset)" />
      <ResolvedFileToPublish Include="@(_PixieGlfwPublishAsset->'$(_PixieGlfwDll)')" CopyToPublishDirectory="Always" />
    </ItemGroup>
    <Error Condition="'@(_PixieGlfwPublishAsset->Count())' != '1'"
           Text="The PixieEditor publish must contain exactly one Windows x64 GLFW provider." />
  </Target>

  <Target Name="VerifyPixieEditorGlfwPublish" AfterTargets="CopyFilesToPublishDirectory"
          Condition="'@(_PixieGlfwPublishAsset)' != ''">
    <VerifyFileHash File="$(PublishDir)%(_PixieGlfwPublishAsset.RelativePath)" Hash="$(_PixieGlfwSha256)" />
  </Target>
</Project>
